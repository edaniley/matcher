# Capacity limits: 3 order slots, 2 price levels, at most 1 finished order retained.
{"op":"config","max_orders":3,"max_levels":2,"retained_orders":1}
{"op":"new","id":1,"account":1,"side":"buy","price":100,"size":5}
{"op":"new","id":2,"account":1,"side":"sell","price":110,"size":5}
# Third price level needed: accepted, then remainder canceled (capacity_exceeded)
{"op":"new","id":3,"account":2,"side":"buy","price":101,"size":1}
{"op":"status","id":3}
# Same price as an existing level: rests (uses the last order slot; #3 is evicted to make room)
{"op":"new","id":4,"account":2,"side":"buy","price":100,"size":1}
{"op":"status","id":3}
# All 3 slots hold resting orders, nothing retained to evict: rejected
{"op":"new","id":5,"account":3,"side":"buy","price":100,"size":1}
{"op":"status","id":5}
# Cancel frees a slot (the canceled order is retained until evicted)
{"op":"cancel","id":4}
{"op":"status","id":4}
{"op":"new","id":5,"account":3,"side":"sell","price":100,"size":2}
{"op":"status","id":4}
{"op":"depth"}
